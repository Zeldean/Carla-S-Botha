{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "object",
      "properties": {
        "af": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "af",
        "en"
      ],
      "additionalProperties": false,
      "description": "Both languages, e.g. { \"af\": \"Kuns\", \"en\": \"Art\" }. Use the same text twice if it doesn't change."
    },
    "medium": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "af": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "af",
            "en"
          ],
          "additionalProperties": false
        }
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 1950,
      "maximum": 2100
    },
    "kind": {
      "type": "string",
      "enum": [
        "painting",
        "drawing",
        "aceo",
        "illustration",
        "other"
      ]
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "af": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "af",
            "en"
          ],
          "additionalProperties": false
        }
      ]
    },
    "image": {
      "type": "string",
      "description": "File name inside public/paintings/art/gallery/."
    },
    "product": {
      "description": "Product slug, if this piece is also for sale.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "published": {
      "default": true,
      "description": "Set to false to hide this item while it's still a draft.",
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "kind",
    "image"
  ],
  "additionalProperties": false
}
